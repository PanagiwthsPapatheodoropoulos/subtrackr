# SubTrackr Backend Configuration Example
PORT=8080

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/subtrackr
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
SPRING_JPA_DDL_AUTO=update

# Security & JWT
JWT_SECRET=your_base64_or_hex_encoded_secret_minimum_256_bits_length_here
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION_DAYS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Web Scraper
SCRAPER_TIMEOUT=10000

# Transactional Email (Brevo)
MAIL_ENABLED=false
MAIL_FROM=notifications@subtrackr.app
MAIL_FROM_NAME=SubTrackr
BREVO_API_KEY=your_brevo_api_key

# Frontend URL
FRONTEND_URL=http://localhost:8081

# Freemium limits
FREEMIUM_MAX_SUBSCRIPTIONS=3
FREEMIUM_MAX_TRACKERS=2

# Google OAuth (Gmail Import)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8081

# AI Email Drafter (Groq Llama 3)
GROQ_API_KEY=your_groq_api_key

# Firebase Push Notifications (Optional path or JSON string)
# FIREBASE_SERVICE_ACCOUNT=src/main/resources/firebase-service-account.json
